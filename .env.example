# Server configuration
PORT=3000
NODE_ENV=development

# Gemini API configuration (server-side only)
GEMINI_API_KEY=

# Optional application configuration
MOCK_AI=0
APP_ACCESS_CODE=
LIVE_VOCABULARY=0
# 1 (default): economy mode for the free API tier. Set 0 on a paid key.
ECONOMY_MODE=1

# Model configurations
LIVE_MODEL=gemini-3.8-live
FAST_MODEL=gemini-3.1-flash-lite
SMART_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_FALLBACK_MODEL=gemini-3.8-flash-tts
FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Development settings
DISABLE_HMR=false
