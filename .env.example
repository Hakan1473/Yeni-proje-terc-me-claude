# Zorunlu: Gemini API anahtarı (AI Studio bunu Secrets panelinden otomatik verir)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Studio'nun otomatik verdiği uygulama adresi
APP_URL="MY_APP_URL"

# İsteğe bağlı: uygulamaya erişim kodu. Tanımlanırsa her cihaz ilk açılışta bu kodu bir kez girer.
# Herkese açık bir adreste API kotanızı korur.
# APP_ACCESS_CODE="1234"

# İsteğe bağlı: API anahtarı olmadan arayüzü denemek için simülasyon modu
# MOCK_AI=1

# İsteğe bağlı model geçersiz kılmaları (varsayılanlar server/config.ts içinde)
# LIVE_MODEL="gemini-3.8-live"
# FAST_MODEL="gemini-3.1-flash-lite"
# SMART_MODEL="gemini-3.8-flash"
# TTS_MODEL="gemini-3.8-flash-lite-tts"
# TTS_FALLBACK_MODEL="gemini-3.8-flash-tts"

# İsteğe bağlı: canlı oturumda tıbbi terim sözlüğünü konuşma tanımaya ipucu olarak gönder (1 = açık).
# Model desteklemezse sistem otomatik olarak sözlüksüz bağlanır.
# LIVE_VOCABULARY=1
